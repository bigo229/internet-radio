---
// src/components/ContactForm.astro
import { SITE } from '../config';
---

<section class="contact-section card">
	<div class="contact-head">
		<h2>Get in Touch</h2>
		<p class="muted">Have feedback, partition inquiries or questions? Send us a message.</p>
	</div>

	<form action="#" method="POST" id="contact-form">
		<div class="form-group">
			<label for="contact-name">Your Name</label>
			<input type="text" name="name" id="contact-name" placeholder="John Doe" required />
		</div>

		<div class="form-group">
			<label for="contact-email">Email Address</label>
			<input type="email" name="email" id="contact-email" placeholder="john@example.com" required />
		</div>

		<div class="form-group">
			<label for="contact-message">Message</label>
			<textarea name="message" id="contact-message" rows="5" placeholder="Type your message here…" required></textarea>
		</div>

		<input type="hidden" name="_subject" value={`New Message from ${SITE.name}!`} />

		<button type="submit" class="btn primary" id="contact-submit-btn">Send Message</button>
		
		<div class="alert" id="contact-alert" role="status"></div>
	</form>
</section>

<script is:inline>
	document.addEventListener('DOMContentLoaded', () => {
		const form = document.getElementById('contact-form');
		const btn = document.getElementById('contact-submit-btn');
		const alert = document.getElementById('contact-alert');

		if (form) {
			form.addEventListener('submit', async (e) => {
				e.preventDefault();
				if (!btn) return;

				btn.disabled = true;
				btn.textContent = 'Sending…';

				if (alert) {
					alert.className = 'alert';
					alert.textContent = '';
				}

				try {
					// 🔑 FIXED: Absolute destination path mapping avoids all template or array parsing glitches
					const formspreeUrl = "https://formspree.io/f/mppzzklr";
					
					const formData = new FormData(form);
					const urlEncodedData = new URLSearchParams(formData);

					const response = await fetch(formspreeUrl, {
						method: 'POST',
						body: urlEncodedData,
						headers: { 
							'Accept': 'application/json'
						}
					});

					let responseData = {};
					try {
						responseData = await response.json();
					} catch (jsonErr) {
						throw new Error('Formspree returned an invalid non-JSON response.');
					}

					if (response.ok || responseData.ok === true) {
						form.reset();
						
						if (alert) {
							alert.className = 'alert show ok';
							alert.textContent = 'Message sent successfully! Redirecting... ✉️';
						}
						
						// 🟢 THE SMOOTH DELAY: Holds the success text for 2 seconds before redirecting
						setTimeout(() => {
							window.location.href = "/thanks";
						}, 2000);

					} else {
						if (responseData.errors) {
							const errorMsg = responseData.errors.map((err) => err.message).join(', ');
							throw new Error(errorMsg);
						}
						throw new Error('Server returned an error status.');
					}
				} catch (error) {
					if (alert) {
						alert.className = 'alert show err';
						alert.textContent = error.message || 'Oops! There was a problem sending your message.';
					}
					btn.disabled = false;
					btn.textContent = 'Send Message';
				}
			});
		}
	});
</script>

<style>
	.contact-section {
		display: flex;
		flex-direction: column;
		gap: 24px;
		padding: 34px;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
		max-width: 600px;
		margin: 0 auto;
	}
	.contact-head h2 {
		font-size: 1.8rem;
		margin-bottom: 6px;
	}
	form {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}
	.form-group {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}
	label {
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--text);
	}
	input, textarea {
		padding: 12px 14px;
		border-radius: var(--radius-sm);
		background: var(--input-bg);
		border: 1px solid var(--border);
		color: var(--text);
		font: inherit;
	}
	input:focus, textarea:focus {
		outline: none;
		border-color: var(--accent);
		box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 22%, transparent);
	}
	.alert {
		display: none;
		padding: 10px;
		border-radius: var(--radius-sm);
		font-size: 0.9rem;
		margin-top: 10px;
	}
	.alert.show {
		display: block;
	}
	.alert.ok {
		background: #d4edda;
		color: #155724;
		border: 1px solid #c3e6cb;
	}
	.alert.err {
		background: #f8d7da;
		color: #721c24;
		border: 1px solid #f5c6cb;
	}
</style>
