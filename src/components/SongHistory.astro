---
interface Props {
	endpoint: string;
	limit?: number;
	title?: string;
	compact?: boolean;
	/** Href for the "view all" link, or false to hide it. */
	viewAll?: string | false;
}

const {
	endpoint,
	limit = 20,
	title = 'Recently Played',
	compact = false,
	viewAll = '/stations',
} = Astro.props;
---

<section class:list={['song-history', { compact }]}>
	<div class="sh-head">
		<h3>{title}</h3>
		{
			viewAll && (
				<a class="sh-all" href={viewAll}>
					View all &rarr;
				</a>
			)
		}
	</div>
	<ul class="sh-list" data-limit={limit} data-endpoint={endpoint}>
		<li class="sh-empty">Loading history&hellip;</li>
	</ul>
</section>

<script>
	<script>
	function escapeHtml(s: string): string {
		return s.replace(
			/[&<>"']/g,
			(c) =>
				({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string
		);
	}

	function render(list: HTMLUListElement, items: any[]) {
		if (!items || !items.length) {
			list.innerHTML = '<li class="sh-empty">No tracks played yet.</li>';
			return;
		}
		list.innerHTML = items
			.map((h, i) => {
				// 🟢 HIGH PRECISION PARSING: Safe navigation extracts AzuraCast's sub-object parameters
				const title = h.song?.title || h.title || 'Unknown Track';
				const artist = h.song?.artist || h.artist || 'Unknown Artist';
				const coverArt = h.song?.art || h.song?.artwork || h.artwork || '/images/default-cover.jpg';
				
				const playedAt = h.played_at || (h.at ? Math.floor(new Date(h.at).getTime() / 1000) : 0);
				const time = playedAt 
					? new Date(playedAt * 1000).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
					: '--:--';

				const current = i === 0 ? ' current' : '';
				
				return `<li class="sh-row${current}">
					<span class="sh-time">${time}</span>
					<span class="sh-eq" aria-hidden="true"><i></i><i></i><i></i></span>
					<div class="sh-thumb-box">
						<img src="${coverArt}" alt="Cover" />
					</div>
					<span class="sh-meta">
						<span class="sh-title">${escapeHtml(title)}</span>
						<span class="sh-artist">${escapeHtml(artist)}</span>
					</span>
				</li>`;
			})
			.join('');
	}

	async function loadList(list: HTMLUListElement) {
		const limit = Number(list.dataset.limit) || 20;
		const endpoint = list.dataset.endpoint || '/api/history.json';
		try {
			const res = await fetch(endpoint, { cache: 'no-store' });
			if (!res.ok) return;
			const json = await res.json();
			
			// 🟢 TARGET AZURACAST STRUCTURE: Pulls directly from the native live 'song_history' object feed array
			let historyItems = [];
			if (json && json.song_history) {
				historyItems = json.song_history;
			} else if (json && json.history) {
				historyItems = json.history;
			} else if (Array.isArray(json)) {
				historyItems = json;
			}
			
			render(list, historyItems.slice(0, limit));
		} catch {
			list.innerHTML = '<li class="sh-empty">Failed to load song history.</li>';
		}
	}

	document.querySelectorAll<HTMLUListElement>('.sh-list').forEach((list) => {
		void loadList(list);
		window.setInterval(() => loadList(list), 30000);
	});
</script>

<style is:global>
	.song-history {
		display: flex;
		flex-direction: column;
		gap: 14px;
	}
	.sh-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 12px;
	}
	.sh-head h3 {
		font-size: 1.15rem;
	}
	.sh-all {
		font-size: 0.85rem;
		color: var(--accent-3);
		font-weight: 500;
	}
	.sh-all:hover {
		text-decoration: underline;
	}
	.sh-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 4px;
		max-height: 420px;
		overflow-y: auto;
	}
	.song-history.compact .sh-list {
		max-height: 320px;
	}
	/* 🟢 FIXED: Expanded column matrix grid schema to accommodate the artwork layout cell neatly */
	.sh-row {
		display: grid;
		grid-template-columns: 56px 18px 40px 1fr;
		align-items: center;
		gap: 12px;
		padding: 10px 12px;
		border-radius: var(--radius-sm);
		transition: background 0.18s ease;
	}
	.sh-row:hover {
		background: var(--surface);
	}
	.sh-time {
		font-size: 0.78rem;
		color: var(--faint);
		font-variant-numeric: tabular-nums;
	}
	.sh-eq {
		display: inline-flex;
		align-items: flex-end;
		gap: 2px;
		height: 14px;
		opacity: 0;
	}
	.sh-eq i {
		width: 3px;
		height: 30%;
		border-radius: 3px;
		background: var(--accent-2);
	}
	/* 🟢 NEW: Clean thumbnail image presentation frame box */
	.sh-thumb-box {
		width: 40px;
		height: 40px;
		border-radius: 6px;
		overflow: hidden;
		background: var(--grad-soft);
		border: 1px solid var(--border);
		display: block;
	}
	.sh-thumb-box img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.sh-meta {
		display: flex;
		flex-direction: column;
		min-width: 0;
		line-height: 1.3;
	}
	.sh-title {
		font-weight: 600;
		font-size: 0.95rem;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.sh-artist {
		font-size: 0.82rem;
		color: var(--muted);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.sh-empty {
		padding: 18px 12px;
		color: var(--faint);
		font-size: 0.9rem;
	}
	.sh-row.current {
		background: var(--grad-soft);
		border: 1px solid var(--border);
	}
	.sh-row.current .sh-title {
		background: var(--grad);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}
	.sh-row.current .sh-eq {
		opacity: 1;
	}
	.sh-row.current .sh-eq i {
		animation: eq 1s ease-in-out infinite;
	}
	.sh-row.current .sh-eq i:nth-child(2) {
		animation-delay: 0.2s;
	}
	.sh-row.current .sh-eq i:nth-child(3) {
		animation-delay: 0.4s;
	}
</style>
