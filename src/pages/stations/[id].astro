---
// src/pages/stations/[id].astro
import Layout from '../../layouts/Layout.astro';
import NowPlaying from '../../components/NowPlaying.astro';
import SongHistory from '../../components/SongHistory.astro';
import { STATIONS } from '../../config';

export function getStaticPaths() {
	return STATIONS.map((station) => ({
		params: { id: station.id },
		props: { station },
	}));
}

const { station } = Astro.props;
const historyEndpoint = `/api/station/${station.id}/nowplaying.json`;
---

<Layout title={station.name} description={station.description}>
	<section class="section">
		<div class="container">
			<div class="station-layout">
				
				<!-- Left Column: Live Player Details -->
				<div class="layout-main">
					<NowPlaying station={station} />
					
					<!-- 🟢 REDESIGNED LINK PANEL: Completely removes the old broken interactive form -->
					<div class="request-panel card" style={`--accent: ${station.accent}`}>
						<div class="panel-head">
							<div class="icon-bubble">🎶</div>
							<h2>Song Requests</h2>
						</div>
						<p class="muted">
							Want to hear your favourite track? Launch our dedicated public requests dashboard to search the active {station.name} library and send your choice straight into the automation queue.
						</p>
						<div class="action-wrapper">
							<a href={station.requestUrl} target="_blank" rel="noopener noreferrer" class="btn primary btn-large">
								Open Request System
							</a>
						</div>
					</div>
				</div>

				<!-- Right Column: Recent Tracks Track Log -->
				<aside class="layout-side">
					<SongHistory endpoint={historyEndpoint} limit={10} viewAll={false} />
				</aside>

			</div>
		</div>
	</section>
</Layout>

<style>
	.station-layout {
		display: grid;
		grid-template-columns: 1.4fr 1fr;
		gap: 32px;
		align-items: start;
	}
	.layout-main {
		display: flex;
		flex-direction: column;
		gap: 24px;
	}
	.request-panel {
		padding: 32px;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		text-align: center;
	}
	.panel-head {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 12px;
		margin-bottom: 16px;
	}
	.icon-bubble {
		font-size: 2rem;
		width: 64px;
		height: 64px;
		background: color-mix(in srgb, var(--accent) 12%, transparent);
		border-radius: 50%;
		display: grid;
		place-items: center;
	}
	.request-panel h2 {
		font-size: 1.6rem;
		margin: 0;
	}
	.request-panel p {
		font-size: 0.98rem;
		line-height: 1.6;
		margin-bottom: 24px;
	}
	.btn-large {
		padding: 12px 32px;
		display: inline-block;
		font-weight: 600;
		text-decoration: none;
	}
	@media (max-width: 860px) {
		.station-layout {
			grid-template-columns: 1fr;
		}
	}
</style>
