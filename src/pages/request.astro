---
// src/pages/request.astro
import Layout from '../layouts/Layout.astro';
import { STATIONS } from '../config';
---

<Layout title="Request a Song" description="Request a track on one of our AzuraCast stations.">
	<section class="section">
		<div class="container narrow">
			<span class="eyebrow"><span class="dot"></span> Song Requests</span>
			<h1 class="page-title">Request a <span class="gradient-text">track</span></h1>
			<p class="muted lead">
				Select a stream below to launch its dedicated request dashboard and choose a song.
			</p>

			<div class="station-grid">
				{
					STATIONS.map((s) => (
						<div class="station-card card" style={`--accent:${s.accent}`}>
							<div class="card-meta">
								<h3>{s.name}</h3>
								<span class="genre-tag">{s.genre}</span>
								<p class="muted">{s.description}</p>
							</div>
							<a href={s.requestUrl} target="_blank" rel="noopener noreferrer" class="btn primary btn-full">
								Open Request System 🎶
							</a>
						</div>
					))
				}
			</div>
		</div>
	</section>
</Layout>

<style>
	.narrow {
		max-width: 800px;
	}
	.page-title {
		font-size: clamp(2rem, 6vw, 3.2rem);
		margin: 14px 0 10px;
	}
	.lead {
		font-size: 1.05rem;
		line-height: 1.6;
		margin-bottom: 32px;
	}
	.station-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 20px;
	}
	.station-card {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		padding: 24px;
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
		background: var(--surface);
	}
	.card-meta h3 {
		font-size: 1.3rem;
		margin-bottom: 4px;
	}
	.genre-tag {
		display: inline-block;
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--accent);
		margin-bottom: 12px;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}
	.card-meta p {
		font-size: 0.92rem;
		line-height: 1.5;
		margin-bottom: 20px;
	}
	.btn-full {
		width: 100%;
		text-align: center;
		display: block;
	}
</style>
